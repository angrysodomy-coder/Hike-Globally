# Payload CMS Environment Variables
PORT=3000

# PostgreSQL Connection String
# Local development default:
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54329/hikeglobally
# Production example:
# DATABASE_URL=postgresql://u812345:YourPass@127.0.0.1:5432/u812345_hikeglobally

# Payload Secret (Generate a 32+ character random secret)
PAYLOAD_SECRET=replace-with-a-secure-random-32-character-secret-in-production

# Server URL
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated)
PAYLOAD_CORS_ORIGIN=http://localhost:5173,https://hikeglobally.com
