# Postgres connection string (Neon / Vercel Postgres). Use a DEV branch locally.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to encrypt sessions & API keys: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob read-write token (only needed when the Blob plugin is enabled)
BLOB_READ_WRITE_TOKEN=

# Absolute URL of this app (no trailing slash).
# This MUST match the origin you actually open the admin panel on — Payload puts
# it on its CSRF allowlist, and requests from any other origin get their auth
# cookie stripped, which surfaces in /admin as
# "You are not allowed to perform this action." when you hit Publish.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Extra origins allowed to make authenticated admin requests, comma-separated.
# Use this for a `www.` alias, a staging/custom domain, an ngrok or Cloudflare
# tunnel, or a cloud dev sandbox that proxies the dev server behind its own host.
# Vercel's own production/preview/branch URLs are trusted automatically.
PAYLOAD_CSRF_ORIGINS=

# Secret shared between the admin panel preview button and /next/preview route
PREVIEW_SECRET=

# Optional: credentials the seed script uses to create the first admin user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-now

# --- Email (optional; without SMTP_HOST, emails are logged to the console) ---
# Any SMTP provider works: Resend SMTP, Postmark, SES, Mailgun…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bookings@yourdomain.com

# Where new-inquiry notifications are sent (your ops team inbox)
INQUIRY_NOTIFY_EMAIL=sales@yourdomain.com

# --- CRM sync (optional) -----------------------------------------------------
# Generic JSON webhook for new inquiries (HubSpot, Pipedrive, Zapier, Make, n8n…)
CRM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" if set
CRM_WEBHOOK_SECRET=
