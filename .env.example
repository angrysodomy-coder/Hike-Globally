# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
#
#     cp .env.example .env.local
#     npm run db:dev    # terminal 1 — embedded Postgres on 127.0.0.1:5433
#     npm run dev       # terminal 2 — http://localhost:3000
#     npm run seed      # first admin user (SEED_* below) + demo content
#
# .env.local is git-ignored, so a fresh clone has NO env file. Without
# POSTGRES_URL node-postgres falls back to localhost:5432 where nothing
# listens, and every /admin login fails with "An unknown error has occurred."
# while the dev server logs `connect ECONNREFUSED 127.0.0.1:5432`.
# ─────────────────────────────────────────────────────────────────────────────

# Matches `npm run db:dev`. To use any other Postgres (Neon branch, system
# install, …), replace this with that database's connection string.
POSTGRES_URL=postgres://payload:payload@127.0.0.1:5433/hike_globally

# Long random string used to encrypt sessions & API keys: openssl rand -hex 32
# (required in production; local dev falls back to a build-time constant if empty)
PAYLOAD_SECRET=

# Absolute URL of this app (no trailing slash) — http://localhost:3000 for dev.
# In production this MUST match the origin you actually open the admin panel on —
# Payload puts it on its CSRF allowlist, and requests from any other origin get
# their auth cookie stripped, which surfaces in /admin as
# "You are not allowed to perform this action." when you hit Publish.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credentials `npm run seed` uses to create the first admin user — this is your
# /admin login. Change the password before seeding anything shared.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-now

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is optional for local development — leave it blank locally
# and set it in your host's dashboard (Vercel → Settings → Environment
# Variables) for production.
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob read-write token (only needed when the Blob plugin is enabled)
BLOB_READ_WRITE_TOKEN=

# Extra origins allowed to make authenticated admin requests, comma-separated.
# Use this for a `www.` alias, a staging/custom domain, an ngrok or Cloudflare
# tunnel, or a cloud dev sandbox that proxies the dev server behind its own host.
# Vercel's own production/preview/branch URLs are trusted automatically.
PAYLOAD_CSRF_ORIGINS=

# Secret shared between the admin panel preview button and /next/preview route
PREVIEW_SECRET=

# --- Email (optional; without SMTP_HOST, emails are logged to the console) ---
# Any SMTP provider works: Resend SMTP, Postmark, SES, Mailgun…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bookings@yourdomain.com

# Where new-inquiry notifications are sent (your ops team inbox)
INQUIRY_NOTIFY_EMAIL=sales@yourdomain.com

# --- CRM sync (optional) -----------------------------------------------------
# Generic JSON webhook for new inquiries (HubSpot, Pipedrive, Zapier, Make, n8n…)
CRM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" if set
CRM_WEBHOOK_SECRET=
