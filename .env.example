# ─────────────────────────────────────────────────────────────────────
# Hike Globally — environment variables
#
# Copy to `.env` for local development:  cp .env.example .env
# Generate each secret with:             openssl rand -base64 32
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# Never put a credential behind that prefix.
# ─────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────
# Encrypts JWTs and any encrypted fields. Changing this in production
# invalidates every session AND breaks decryption of existing data.
PAYLOAD_SECRET=

# No trailing slash. Drives CORS, canonical URLs, OG image URLs and
# email links. On Vercel this can be left blank in production —
# VERCEL_PROJECT_PRODUCTION_URL is used as the fallback.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Database (Neon Postgres) ────────────────────────────────────────
# POOLED endpoint (hostname contains `-pooler`). Used by the running app.
# Neon's PgBouncer handles serverless connection churn; keep the client-side
# pool small (see payload.config.ts) so you do not stack pools on top of it.
# Vercel's Neon integration sets this automatically in deployed environments.
# Use a SEPARATE Neon branch for Preview deployments so a stray Publish in a
# preview admin can never write to production.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# DIRECT (unpooled) endpoint — no `-pooler` in the hostname.
# Migrations issue DDL, which is unreliable through PgBouncer's transaction
# pooling. `npm run migrate` uses this when it is set.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Media storage (Cloudflare R2 over the S3 API) ───────────────────
# Leave S3_BUCKET empty in local development and Payload falls back to
# local disk — the storage plugin is gated on `enabled: Boolean(S3_BUCKET)`.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public CDN domain mapped to the bucket. Must also appear in
# next.config.ts → images.remotePatterns (it is wired up automatically).
NEXT_PUBLIC_MEDIA_URL=

# ─── Preview and scheduled jobs ──────────────────────────────────────
# Must be a DIFFERENT value from PAYLOAD_SECRET.
PREVIEW_SECRET=

# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@hikeglobally.com
ENQUIRY_NOTIFICATION_EMAIL=bookings@hikeglobally.com
